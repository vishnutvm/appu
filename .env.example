# Appu AI Brain Configuration (Google Gemini)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/

# Google Gemini API Key (Backend-only, never sent to renderer)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Configurable Gemini Model (defaults to gemini-3.5-flash-lite)
# Supported options include: gemini-3.5-flash-lite, gemini-3.8-flash, gemini-3.1-flash-lite, gemini-flash-lite-latest
GEMINI_MODEL=gemini-3.5-flash-lite
